# Copy to .env (never commit .env). All values optional – without them the collector calls OpenSky anonymously and
# there is no backfill.

# OpenSky account: 4,000 credits per day instead of 400 per IP address (everyone behind the same router shares those)
# https://opensky-network.org -> Account -> API client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Aircraft photos (planespotters.net) – their terms ask for a contact in every request: your own e-mail address.
# Without it the app simply shows no photos.
PHOTO_CONTACT=

# The app: seconds between OpenSky calls at start (changeable in the app). 35 = one day on an account's 4,000 credits
# INTERVAL=35

# --- Optional, advanced: your OWN S3-compatible archive of OpenSky snapshots (Cloudflare R2 or similar) -----------
# Only if you run a producer that stores every answer as <region>/year=YYYY/month=MM/day=DD/hour=HH/<region>_<time>.json.gz
# (notebook 04 explains the layout). The course author's archive is not public – leave these empty otherwise.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com/<bucket>
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Also mirror the world feed from that archive into the app (every 6 min, ~13,000 aircraft):
# R2_REGIONS=world
